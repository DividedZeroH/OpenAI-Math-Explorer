{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/preprints/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.pdf)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/math_web/index.html"
    },
    {
      "source": "/data.json",
      "destination": "/math_web/data.json"
    },
    {
      "source": "/math_web/preprints/(.*)",
      "destination": "/preprints/$1"
    },
    {
      "source": "/preprints/(.*)",
      "destination": "/preprints/$1"
    },
    {
      "source": "/reasoning_traces/(.*)",
      "destination": "/reasoning_traces/$1"
    },
    {
      "source": "/math_web/(.*)",
      "destination": "/math_web/$1"
    }
  ]
}
